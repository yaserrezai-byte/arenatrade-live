# ==============================================================================
# تنظیمات سیستم چند-ایجنته تحلیلگر فیوچرز ارز دیجیتال و کپی‌تریدر هوشمند
# ==============================================================================

# --- ۱. تنظیمات کانال و ربات تلگرام ---
# توکن ربات تلگرام از @BotFather (مثال: 7123456789:AAH...)
TELEGRAM_BOT_TOKEN=
# آیدی عددی کانال یا یوزرنیم عمومی کانال (مثال: @my_futures_channel یا -1001234567890)
# توجه: ربات باید در کانال به عنوان Admin با دسترسی ارسال پیام اضافه شود
TELEGRAM_CHAT_ID=
# ارسال خودکار سیگنال‌های تاییدشده و هشدار تعویض کپی‌تریدر به تلگرام
TELEGRAM_AUTO_SEND=true

# --- ۲. موتور هوش مصنوعی بهینه (انتخاب خودکار بهترین مدل موجود) ---
# سیستم به صورت هیبریدی طراحی شده است:
# ۱) محاسبات تکنیکال، جریان پول، ساختار بازار، حمایت/مقاومت و کپی‌ترید به صورت الگوریتمی دقیق انجام می‌شود.
# ۲) در صورت وارد کردن هر یک از کلیدهای زیر، ایجنت اخبار و مدیر تصمیم‌گیرنده از LLM نیز برای استدلال عمیق استفاده می‌کنند.
# ترتیب اولویت خودکار: OPENROUTER -> GEMINI -> DEEPSEEK -> OPENAI -> QUANT_ENGINE (بدون هزینه)
AI_PROVIDER=auto

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- ۳. تنظیمات استراتژی فیوچرز، تایم‌فریم و مدیریت ریسک ---
# لیست ارزهای مورد پایش (جدا شده با کاما)
WATCHLIST=BTC,ETH,SOL,XRP,DOGE,SUI,AVAX,LINK
# تایم‌فریم اصلی ورود و تایم‌فریم روند بالاتر
PRIMARY_TIMEFRAME=1h
HTF_TIMEFRAME=4h
LTF_TIMEFRAME=15m

# مدیریت ریسک و سرمایه در فیوچرز
MAX_LEVERAGE=10
DEFAULT_RISK_PER_TRADE_PCT=1.5
MIN_CONFIDENCE_SCORE=62
MIN_RISK_REWARD_RATIO=2.0
ESTIMATED_ROUND_TRIP_COST_PCT=0.18
STRATEGY_VERSION=MA_V1_FROZEN_2026_11_05
VALIDATION_ENTRY_WINDOW_BARS=8
VALIDATION_MAX_HOLD_BARS=96

# --- ۴. تنظیمات ایجنت کپی‌تریدر هوشمند (Hyperliquid + CEX) ---
# حداکثر تعداد اشتباه متوالی مجاز قبل از تعویض خودکار تریدر (پیش‌فرض طبق درخواست: 2)
COPY_TRADER_MAX_CONSECUTIVE_LOSSES=2
# حداقل سرمایه حساب تریدر برتر (دلار) برای فیلتر کردن حساب‌های کوچک
COPY_TRADER_MIN_EQUITY_USD=50000
# تعداد تریدرهای برتر ذخیره شده در لیست ذخیره (Standby Queue)
COPY_TRADER_ROSTER_SIZE=12

# --- ۵. تنظیمات سرور وب و اسکنر خودکار پس‌زمینه ---
HOST=0.0.0.0
PORT=8000
AUTO_SCAN_ENABLED=true
AUTO_SCAN_INTERVAL_SEC=900
SCAN_SYNC_CANDLE_CLOSE=true
COPY_MONITOR_INTERVAL_SEC=90
